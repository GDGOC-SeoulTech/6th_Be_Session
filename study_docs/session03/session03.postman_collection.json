{
  "info": {
    "name": "GDGoC 세션 03 체크포인트",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "폴더별 실행: 00은 시작 코드, 01은 CRUD와 Swagger 완성 후, 02는 검색 완성 후. 00을 다시 실행하면 새 글과 번호가 준비됩니다. STEP 5 주석 제거 실험은 Notion 안내에 따라 별도로 실행합니다.",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "postId",
      "value": ""
    },
    {
      "key": "deleteId",
      "value": ""
    },
    {
      "key": "searchId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 사전 준비",
      "item": [
        {
          "name": "1 조회·수정용 글 저장",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/posts",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"첫 번째 게시글\", \"content\": \"안녕하세요!\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"postId\", String(pm.response.json().id));"
                ]
              }
            }
          ]
        },
        {
          "name": "2 검색용 글 저장",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/posts",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"스프링 공부\", \"content\": \"JPA\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"searchId\", String(pm.response.json().id));"
                ]
              }
            }
          ]
        },
        {
          "name": "3 삭제용 글 저장",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/posts",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"세 번째\", \"content\": \"삭제용\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"deleteId\", String(pm.response.json().id));"
                ]
              }
            }
          ]
        },
        {
          "name": "4 목록 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/posts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"준비한 글 3개 확인\", () => { const ids = pm.response.json().map(p => String(p.id)); [\"postId\", \"searchId\", \"deleteId\"].forEach(k => pm.expect(ids).to.include(pm.collectionVariables.get(k))); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 CRUD 확인 (STEP 1~3 및 6 완료 후)",
      "item": [
        {
          "name": "1 단건 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/posts/{{postId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2 제목·내용 수정",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/posts/{{postId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"수정된 제목\", \"content\": \"수정된 내용\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "3 제목만 수정",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/posts/{{postId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"제목만 수정\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"기존 내용 유지\", () => pm.expect(pm.response.json().content).to.eql(\"수정된 내용\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "4 DB에 수정 반영 확인",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/posts/{{postId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"재조회 결과 확인\", () => { const p = pm.response.json(); pm.expect(p.title).to.eql(\"제목만 수정\"); pm.expect(p.content).to.eql(\"수정된 내용\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "5 삭제용 글 삭제",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/posts/{{deleteId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "6 삭제 결과 목록 확인",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/posts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"삭제용 글 없음\", () => pm.expect(pm.response.json().map(p => String(p.id))).not.to.include(pm.collectionVariables.get(\"deleteId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "7 없는 글 조회 (현재 예제는 500)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/posts/9223372036854775807"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 500\", () => pm.response.to.have.status(500));"
                ]
              }
            }
          ]
        },
        {
          "name": "8 Swagger API 문서",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v3/api-docs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"게시글 경로 확인\", () => { const paths = pm.response.json().paths; pm.expect(paths).to.have.property(\"/posts\"); pm.expect(paths).to.have.property(\"/posts/{postId}\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 검색 과제 확인 (STEP 7 완료 후)",
      "item": [
        {
          "name": "검색어 포함 결과",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/posts/search?keyword=스프링"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"검색용 게시글 포함\", () => { const posts = pm.response.json(); pm.expect(posts.map(p => String(p.id))).to.include(pm.collectionVariables.get(\"searchId\")); posts.forEach(p => pm.expect(p.title).to.include(\"스프링\")); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
